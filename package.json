{
  "name": "sheepcontabil-assets",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:fonts && npm run build:js",
    "build:css": "tailwindcss -i src/static_src/app.css -o src/static/css/app.css --minify",
    "build:fonts": "node scripts/copy-fonts.mjs",
    "build:js": "node scripts/build-js.mjs",
    "watch:css": "tailwindcss -i src/static_src/app.css -o src/static/css/app.css --watch",
    "watch:js": "node scripts/build-js.mjs --watch"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans": "^5.2.6",
    "alpinejs": "^3.15.0",
    "htmx.org": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "railway": "3.11.0",
    "tailwindcss": "^4.1.14"
  }
}
