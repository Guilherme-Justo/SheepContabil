DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Em execução Python local, vazio usa SQLite em var/dev.sqlite3.
# O Compose injeta a URL privada do PostgreSQL automaticamente.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
# 15 min de limite rígido < 20 min de invisibilidade < 30 min para reconciliar;
# filas cuja publicação foi confirmada pelo broker não expiram apenas por idade.
CELERY_BROKER_VISIBILITY_TIMEOUT_SECONDS=1200
AUTOMATION_QUEUED_STALE_AFTER_SECONDS=1800
AUTOMATION_RUNNING_STALE_AFTER_SECONDS=1800
AUTOMATION_RECONCILIATION_MAX_ATTEMPTS=1
APP_TIME_ZONE=America/Sao_Paulo
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_EMAIL=admin@sheepcontabil.local
DEMO_ADMIN_PASSWORD=
DEMO_OPERATOR_USERNAME=operador.processos
DEMO_OPERATOR_EMAIL=operador.processos@sheepcontabil.local
DEMO_OPERATOR_PASSWORD=
DEMO_SOCIETARY_OPERATOR_USERNAME=operador.societario
DEMO_SOCIETARY_OPERATOR_EMAIL=operador.societario@sheepcontabil.local
# Se omitida, DEMO_SOCIETARY_OPERATOR_PASSWORD reutiliza DEMO_OPERATOR_PASSWORD.
DEMO_SOCIETARY_OPERATOR_PASSWORD=
DEMO_FISCAL_OPERATOR_USERNAME=operador.fiscal
DEMO_FISCAL_OPERATOR_EMAIL=operador.fiscal@sheepcontabil.local
# Se omitida, DEMO_FISCAL_OPERATOR_PASSWORD reutiliza DEMO_OPERATOR_PASSWORD.
DEMO_FISCAL_OPERATOR_PASSWORD=
DEMO_TECHNOLOGY_OPERATOR_USERNAME=operador.tecnologia
DEMO_TECHNOLOGY_OPERATOR_EMAIL=operador.tecnologia@sheepcontabil.local
# Se omitida, DEMO_TECHNOLOGY_OPERATOR_PASSWORD reutiliza DEMO_OPERATOR_PASSWORD.
DEMO_TECHNOLOGY_OPERATOR_PASSWORD=
OPENAI_API_KEY=
# Defina explicitamente um modelo disponível na conta e validado com a massa sintética.
OPENAI_MODEL=
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=sheep-local
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=sheepcontabil
S3_REGION=auto
S3_ADDRESSING_STYLE=path
SC04_MAX_UPLOAD_BYTES=10485760
SC04_MAX_EXTRACTED_CHARS=50000
SC04_MAX_PDF_PAGES=20
SC04_MAX_IMAGE_PIXELS=25000000
SC04_OCR_TIMEOUT_SECONDS=30
SC04_OPENAI_TIMEOUT_SECONDS=30
SC04_AUTO_ROUTE_THRESHOLD=0.85
# Horários de agendamento em APP_TIME_ZONE (0-23)
SC04_DAILY_HOUR=8
SC20_MONTHLY_HOUR=8
SC04_TESSERACT_LANGUAGE=por
SC05_SIMULATOR_BASE_URL=http://localhost:8010
SC05_SIMULATOR_DJANGO_SECRET_KEY=
SC05_SIMULATOR_USERNAME=sheep-rpa
SC05_SIMULATOR_PASSWORD=
SC05_RPA_TIMEOUT_MS=10000

# ==============================================================================
# NOTIFICAÇÕES & E-MAIL REAL (SC-20)
# ==============================================================================
# Backend de notificação: "simulated" (padrão de demonstração) ou "email" (envio real via SMTP)
SC20_NOTIFICATION_BACKEND=simulated
# Endereço para redirecionamento seguro em testes de e-mail (sandbox trap)
# Quando preenchido, todos os avisos disparados são entregues neste e-mail
SC20_EMAIL_OVERRIDE_TO=
# Número de WhatsApp para redirecionamento seguro em testes (ex: 5521999998888)
SC20_WHATSAPP_OVERRIDE_TO=

# Configurações do Provedor de E-mail (exemplo: Gmail SMTP)
# Para desenvolvimento local sem envio real: django.core.mail.backends.console.EmailBackend
# Para envio real: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
# Use Senha de Aplicativo de 16 caracteres gerada na Conta Google (https://myaccount.google.com/apppasswords)
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SheepContabil <avisos@sheepcontabil.local>
